{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    "api": {
      "entry": ["src/app.ts", "scripts/**/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    },
    "web": {
      "entry": ["src/App.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "mobile": {
      "entry": ["App.tsx", "index.ts"],
      "project": ["src/**/*.{ts,tsx}", "App.tsx", "index.ts"]
    },
    ".": {
      "entry": ["scripts/**/*.ts"],
      "project": ["scripts/**/*.ts", "shared/**/*.ts"]
    }
  }
}
