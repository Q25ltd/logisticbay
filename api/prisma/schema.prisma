generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id                           Int      @id @default(autoincrement())
  name                         String
  slug                         String   @unique
  ticker                       String?  @unique
  nextJobSequence              Int      @default(1)
  jobSequenceYear              Int      @default(2026)
  nextRunSequence              Int      @default(1)
  runSequenceYear              Int      @default(2026)
  status                       String   @default("trial")
  type                         String   @default("carrier")  // "carrier" | "sender" | "both"
  reportEmail                  String?
  reportEmailEnabled           Boolean  @default(true)
  maxHolidaysPerDay            Int      @default(2)
  holidayYearResetMonth        Int      @default(1)
  holidayYearResetDay          Int      @default(1)
  holidayWarnDaysBefore        Int      @default(30)
  holidayCarryOverAllowed      Boolean  @default(false)
  holidayCarryOverMaxDays      Int      @default(0)
  baseHolidayAllowanceDays     Int      @default(28)
  holidaySeniorityEnabled      Boolean  @default(true)
  holidaySeniorityYears        Int      @default(5)
  holidaySeniorityExtraDays    Int      @default(1)
  holidaySeniorityMaxExtraDays Int      @default(5)
  depotLocationId              Int?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  memberships      CompanyMembership[]
  driverProfiles   DriverProfile[]
  savedLocations   SavedLocation[]
  depotLocation    SavedLocation?      @relation("CompanyDepot", fields: [depotLocationId], references: [id])
  customers        Customer[]
  jobTemplates     JobTemplate[]
  jobs             Job[]
  jobEvents        JobExecutionEvent[]
  shifts           Shift[]
  shiftSegments    ShiftSegment[]
  deliveryTasks    DeliveryTask[]
  availability     DriverAvailability[]
  shiftPreferences ShiftPreference[]
  holidayRequests  HolidayRequest[]
  workingSummaries DriverWorkingTimeSummary[]
  syncEventLogs    SyncEventLog[]
  jobParts         JobPart[]
  jobAudits        JobAudit[]
  auditLogs        AuditLog[]
  fleetUnits       FleetUnit[]
  fleetTrailers    FleetTrailer[]
  requestLinks     ClientRequestLink[]
  runs             Run[]
  runAssignments   RunAssignment[]
  loadTracks       LoadTrack[]
  shiftSubmitJobs  ShiftSubmitJob[]
}

model Customer {
  id           Int      @id @default(autoincrement())
  companyId    Int
  name         String
  contactName  String?
  contactPhone String?
  contactEmail String?
  notes        String?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company      Company             @relation(fields: [companyId], references: [id])
  jobs         Job[]
  requestLinks ClientRequestLink[]

  @@unique([companyId, name])
  @@index([companyId, status])
}

model User {
  id                   Int       @id @default(autoincrement())
  name                 String
  email                String    @unique
  passwordHash         String
  status               String    @default("active")
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  memberships              CompanyMembership[]
  driverProfile            DriverProfile?
  shifts                   Shift[]
  createdJobs              Job[]               @relation("JobCreatedBy")
  jobEvents                JobExecutionEvent[]
  jobAudits                JobAudit[]
  auditLogs                AuditLog[]
  refreshTokens            RefreshToken[]
  createdRequestLinks      ClientRequestLink[]
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model EmailVerificationToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model RefreshToken {
  id         Int       @id @default(autoincrement())
  userId     Int
  companyId  Int
  tokenHash  String    @unique
  familyId   String
  userAgent  String    @default("")
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt])
  @@index([familyId])
}

model CompanyMembership {
  id        Int      @id @default(autoincrement())
  companyId Int
  userId    Int
  role      String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([companyId, userId])
}

model DriverProfile {
  id                    Int       @id @default(autoincrement())
  companyId             Int
  userId                Int?      @unique
  displayName           String
  employeeNumber        String?
  phoneNumber           String?
  employmentStartDate   DateTime?
  contactEmail          String?
  contactPhone          String?
  driverType            String    @default("permanent")
  workPattern           String?   // "day_driver" | "night_driver" | "tramper"
  licenceClass          String    @default("")
  endorsements          Json?
  canDriveCategories    Json?
  canUseTrailer         Boolean   @default(false)
  trailerTypesAllowed   Json?
  adrAllowed            Boolean   @default(false)
  hiabAllowed           Boolean   @default(false)
  moffettAllowed        Boolean   @default(false)
  manualHandlingAllowed Boolean   @default(false)
  preferredStartTime    String    @default("")
  earliestStartTime     String    @default("")
  latestFinishTime      String    @default("")
  preferredShiftHours   Float?
  normalWorkingDays     Json?
  weekendAvailable      Boolean   @default(false)
  nightWorkAllowed      Boolean   @default(false)
  nightsOutAllowed      Boolean   @default(false)
  overtimeAllowed       Boolean   @default(false)
  baseLocation          String    @default("")
  basePostcode          String?   // home/depot postcode — geocoded to baseLat/baseLng
  baseLat               Float?
  baseLng               Float?
  operatingArea         String    @default("")
  avoidAreas            String    @default("")
  plannerNotes          String    @default("")
  minHoursPerDay        Float     @default(8)
  holidayAllowance      Int       @default(28)
  holidayUsed           Int       @default(0)
  defaultTruckReg       String    @default("")
  defaultTruckClass     String    @default("")
  defaultTrailerReg     String    @default("")
  defaultTrailerClass   String    @default("")
  status                String    @default("active")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  company          Company                    @relation(fields: [companyId], references: [id])
  user             User?                      @relation(fields: [userId], references: [id])
  runs             Run[]
  availability     DriverAvailability[]
  shiftPreferences ShiftPreference[]
  holidayRequests  HolidayRequest[]
  workingSummaries DriverWorkingTimeSummary[]

  @@index([companyId, status])
  @@index([companyId, displayName])
}

model SavedLocation {
  id                   Int      @id @default(autoincrement())
  companyId            Int
  name                 String
  siteName             String?
  unitName             String?
  locationTextSnapshot String?
  street               String?
  town                 String?
  postcode             String?
  lat                  Float?
  lng                  Float?
  gateLat              Float?
  gateLng              Float?
  contactName          String?
  contactPhone         String?
  instructions         String?
  internalNotes        String?
  accessType           String   @default("unknown")
  accessConfidence     String   @default("low")
  driverReportCount    Int      @default(0)
  issueFlags           Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company          Company       @relation(fields: [companyId], references: [id])
  depotForCompanies Company[]   @relation("CompanyDepot")
  pickupTemplates  JobTemplate[] @relation("PickupLocation")
  dropoffTemplates JobTemplate[] @relation("DropoffLocation")
  jobParts         JobPart[]
  runWaypoints     RunWaypoint[] @relation("RunWaypointLocation")

  @@index([companyId, name])
  @@index([companyId, postcode])
}

model JobTemplate {
  id                  Int      @id @default(autoincrement())
  companyId           Int
  name                String
  pickupLocationId    Int?
  dropoffLocationId   Int?
  pickupTextSnapshot  String?
  dropoffTextSnapshot String?
  defaultReference    String?
  defaultNotes        String?
  defaultMaterialType String?
  trailerTypesAllowed Json?
  defaultStops        Json?
  defaultLoadDetails  Json?
  defaultJobData      Json?
  qualityScore        Int      @default(0)
  status              String   @default("active")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company         Company        @relation(fields: [companyId], references: [id])
  pickupLocation  SavedLocation? @relation("PickupLocation", fields: [pickupLocationId], references: [id])
  dropoffLocation SavedLocation? @relation("DropoffLocation", fields: [dropoffLocationId], references: [id])
  jobs            Job[]

  @@index([companyId, status])
}

// ── Job — the single record for all transport jobs ───────────────────────────
// Both PRF (customer request) and CJP (planner direct create) write here.
// PRF creates with status=pending_review; CJP creates with status=draft or ready_to_plan.
// Accept step: sets plannedDate + plannerNotes, flips status to ready_to_plan.
//
// Status flow:
//   pending_review → ready_to_plan (PRF accepted)
//   draft          → ready_to_plan (CJP confirmed)
//   ready_to_plan  → in_planning   → planned → in_progress → completed
//   any            → cancelled
model Job {
  id              Int       @id @default(autoincrement())
  companyId       Int
  customerId      Int?
  templateId      Int?
  createdByUserId Int
  parentJobId     Int?      // self-relation — set when job is split from a parent

  // ── identity ──────────────────────────────────────────────────────────────
  jobReference    String?
  status          String    @default("draft")
  priority        String    @default("normal")
  jobTitle        String?

  // ── scheduling ────────────────────────────────────────────────────────────
  plannedDate      DateTime?
  serviceType      String?
  jobType          String?
  canSplitShipment String    @default("must_stay_together")

  // ── customer ──────────────────────────────────────────────────────────────
  customerName        String?
  customerRef         String?
  purchaseOrderNumber String?
  billingReference    String?
  declaredGoodsValue  String?
  billingNotes        String?

  bookingContactName  String?
  bookingContactPhone String?
  bookingContactEmail String?
  custRefRequired     Boolean @default(false)
  poRequired          Boolean @default(false)

  // ── planner ───────────────────────────────────────────────────────────────
  plannerNotes       String?
  internalNotes      String?
  driverNoteChips    Json?   // string[] — chips shown to driver on mobile
  driverVisibleNotes String?
  safetyInstructions String?

  // ── load (merged from LoadDetails) ────────────────────────────────────────
  goodsType            String?
  goodsDescription     String?
  quantity             Float?
  quantityUnit         String?
  weight               Float?
  volume               Float?
  dimensions           String?
  fragile              Boolean @default(false)
  stackable            Boolean @default(false)
  tempControlled       Boolean @default(false)
  tempRange            String?
  hazardClass          String?
  tunnelCode           String?                // ADR tunnel restriction code (B / C / C/D / C/E / D / D/E / E)
  photosRequired       Boolean @default(false)
  weighbridgeRequired  Boolean @default(false)
  securingRequirements Json?   // string[]
  specialRequirements  Json?   // string[]
  loadData             Json?   // goods-type sub-details blob (pallets, cages, machinery, containers, etc.)

  // ── vehicle requirements ──────────────────────────────────────────────────
  // What the job NEEDS — system checks against fleet/driver at assignment time.
  vehicleCategory    String?                // matches FleetUnit.bodyCategory
  bodyTypes          Json?                  // string[] — each value matches FleetUnit.bodyType
  minGvwClass        String?                // matches FleetUnit.gvwClass
  equipment          Json?                  // string[] — matches FleetUnit.onboardEquipment
  trailersAllowed    Json?                  // string[] — matches FleetTrailer.bodyType
  vehicleAccessNotes String?

  // ── exception policy ──────────────────────────────────────────────────────
  failureAction                 String  @default("call_assistance")
  assistancePhone               String?
  assistanceNote                String?
  approvalContactName           String?
  approvalContactPhone          String?
  alternativeReturnAddress      String?
  alternativeReturnPostcode     String?
  alternativeReturnContactName  String?
  alternativeReturnContactPhone String?
  alternativeReturnSiteName              String?
  alternativeReturnAddressLine2          String?
  alternativeReturnTown                  String?
  alternativeReturnCounty                String?
  alternativeReturnCountry               String?
  alternativeReturnLat                   Float?
  alternativeReturnLng                   Float?
  alternativeReturnNavigationInstructions String?
  photosRequiredOnRejection   Boolean @default(false)
  rejectionSignatureRequired  Boolean @default(false)
  rejectionNotes              String?

  // ── proof / quality ───────────────────────────────────────────────────────
  requirePOD       Boolean @default(false)
  validationStatus String  @default("draft")
  qualityScore     Int     @default(0)

  // ── override close ────────────────────────────────────────────────────────
  overrideClosed            Boolean  @default(false)
  overrideReason            String?
  overrideNotes             String?
  overrideQuantityDelivered Decimal?
  overrideQuantityShortfall Decimal?
  closedAt                  DateTime?
  closedBy                  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company             @relation(fields: [companyId], references: [id])
  customer       Customer?           @relation(fields: [customerId], references: [id])
  template       JobTemplate?        @relation(fields: [templateId], references: [id])
  createdBy      User                @relation("JobCreatedBy", fields: [createdByUserId], references: [id])
  parent         Job?                @relation("JobChildren", fields: [parentJobId], references: [id])
  children       Job[]               @relation("JobChildren")
  stops          JobPart[]
  events         JobExecutionEvent[]
  audits         JobAudit[]
  runAssignments RunAssignment[]
  loadTracks     LoadTrack[]

  @@unique([companyId, jobReference])
  @@index([companyId, plannedDate])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([companyId, updatedAt])
  @@index([companyId, jobReference])
}

// Renamed from JobStop — represents one physical piece of work (collect, deliver, etc.)
model JobPart {
  id        Int @id @default(autoincrement())
  companyId Int
  jobId     Int

  sequenceNumber Int
  type           String

  savedLocationId      Int?
  siteName             String?
  unitName             String?
  street               String?
  town                 String?
  postcode             String?
  locationTextSnapshot String?

  lat     Float?
  lng     Float?
  gateLat Float?
  gateLng Float?

  coordinateVerified Boolean @default(false)

  timeWindowStart           DateTime?
  timeWindowEnd             DateTime?
  bookedTime                DateTime?
  earliestArrivalMinutes    Int?
  unloadingAllowanceMinutes Int?
  standingChargeNote        String?

  contactName     String?
  contactPhone    String?
  contactEmail    String?
  referenceNumber String?
  bookingRequired Boolean @default(false)
  bookingRef      String?
  openingHours    String?
  instructions    String?
  navigationInstructions String?
  locationType    String?

  // Quantity tracking
  numPallets         Int?     // legacy field — kept for mobile compatibility
  quantityRequired   Decimal?
  quantityUnit       String?
  quantityCollected  Decimal  @default(0)
  quantityDelivered  Decimal  @default(0)

  // Proof and access requirements
  proofRequirements  Json?   // ["signature", "photo", "pod_number", "timestamp"]
  accessRequirements Json?   // ["ppe", "high_vis", "induction"]
  handlingMethods    Json?   // ["forklift", "tail_lift", "crane", "manual"]

  // Equipment exchange / asset return at this stop
  exchangeDropQty    Decimal?
  exchangeCollectQty Decimal?
  exchangeUnit       String?
  // Load readiness reported by customer
  loadReadiness      String?

  // Stop-level load specification — drives trailer compatibility checks
  stopGoodsType        String?
  stopWeight           Decimal?
  tempControlled       Boolean  @default(false)
  tempRange            String?
  hazardous            Boolean  @default(false)
  hazardClass          String?
  oversized            Boolean  @default(false)

  heightRestriction String?
  weightRestriction String?
  lengthRestriction String?
  internalNotes     String?
  stopNotes         String?
  addressLine2      String?
  countyRegion      String?
  country           String @default("United Kingdom")

  status String @default("pending")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id])
  job            Job             @relation(fields: [jobId], references: [id])
  savedLocation  SavedLocation?  @relation(fields: [savedLocationId], references: [id])
  runAssignments RunAssignment[]
  loadTracks     LoadTrack[]

  @@map("JobPart")
  @@unique([jobId, sequenceNumber])
  @@index([companyId, jobId])
  @@index([companyId, savedLocationId])
}

model JobAudit {
  id        Int  @id @default(autoincrement())
  companyId Int
  jobId     Int
  changedBy Int?

  action   String
  field    String @default("")
  oldValue Json?
  newValue Json?

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  job     Job     @relation(fields: [jobId], references: [id])
  user    User?   @relation(fields: [changedBy], references: [id])

  @@index([companyId, jobId])
  @@index([createdAt])
}

model JobExecutionEvent {
  id               Int      @id @default(autoincrement())
  jobId            Int
  companyId        Int
  driverId         Int
  eventType        String
  note             String   @default("")
  clientEventId    String
  clientTimestamp  DateTime
  serverReceivedAt DateTime @default(now())
  appVersion       String?
  gpsLat           Float?
  gpsLng           Float?
  needsReview      Boolean  @default(false)
  reviewReason     String?
  createdAt        DateTime @default(now())

  // Phase 1 additions — links to new models (null for historical events)
  runId             Int?
  runAssignmentId   Int?
  jobPartId         Int?
  quantityConfirmed Decimal?
  fromCustody       String?
  toCustody         String?

  job        Job            @relation(fields: [jobId], references: [id])
  company    Company        @relation(fields: [companyId], references: [id])
  driver     User           @relation(fields: [driverId], references: [id])
  run        Run?           @relation(fields: [runId], references: [id])
  loadTracks LoadTrack[]

  @@unique([companyId, clientEventId])
  @@index([companyId, createdAt])
  @@index([companyId, runId])
}

// ── Run — the execution container (independent of Job) ───────────────────────
model Run {
  id                          Int       @id @default(autoincrement())
  companyId                   Int
  runReference                String
  status                      String    @default("draft")
  runType                     String?   // direct | relay | split | consolidation
  dependsOnRunId              Int?      // relay: this run cannot start until that run completes
  assignedDriverId            Int?
  assignedTruckId             Int?
  assignedTrailerId           Int?
  plannedDate                 DateTime?
  estimatedStartTime          String?
  estimatedEndTime            String?
  actualStartTime             DateTime?
  actualEndTime               DateTime?
  publishedToDriver           Boolean   @default(false)
  plannerNotes                String?
  endInstruction              String?   // drop_trailer_at_base | stay_with_trailer | none
  endInstructionNote          String?
  returnToBase                Boolean   @default(false)
  returnToBaseNote            String?
  returningAt                 DateTime?
  arrivedBaseAt               DateTime?

  // Derived requirements — recalculated when assignments change
  requiredTrailerType         String?
  requiredEquipment           Json?
  maxLoadWeight               Decimal?
  hasHazardous                Boolean   @default(false)
  hasTemperatureLoad          Boolean   @default(false)
  hasOversized                Boolean   @default(false)

  // Compatibility check results — updated at publish time
  trailerCompatible           Boolean   @default(true)
  vehicleCompatible           Boolean   @default(true)
  compatibilityOverridden     Boolean   @default(false)
  compatibilityOverrideReason String?

  createdBy Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company           @relation(fields: [companyId], references: [id])
  driver         DriverProfile?    @relation(fields: [assignedDriverId], references: [id])
  assignments    RunAssignment[]
  waypoints      RunWaypoint[]
  loadTracks     LoadTrack[]
  events         JobExecutionEvent[]
  dependsOn      Run?              @relation("RunDependency", fields: [dependsOnRunId], references: [id])
  dependents     Run[]             @relation("RunDependency")

  @@unique([companyId, runReference])
  @@index([companyId, plannedDate])
  @@index([companyId, status])
  @@index([companyId, assignedDriverId])
}

// ── RunAssignment — bridge between JobPart and Run ───────────────────────────
model RunAssignment {
  id               Int       @id @default(autoincrement())
  companyId        Int
  runId            Int
  jobPartId        Int
  jobId            Int
  sequenceNumber   Int
  quantityAssigned Decimal   @default(0)
  quantityUnit     String    @default("")
  status           String    @default("pending")
  addedAt          DateTime  @default(now())
  addedBy          Int
  removedAt        DateTime?
  removedBy        Int?
  removalReason    String?
  notes            String?

  company    Company    @relation(fields: [companyId], references: [id])
  run        Run        @relation(fields: [runId], references: [id])
  jobPart    JobPart    @relation(fields: [jobPartId], references: [id])
  job        Job        @relation(fields: [jobId], references: [id])
  loadTracks LoadTrack[]

  @@unique([runId, sequenceNumber])
  @@index([companyId, runId])
  @@index([companyId, jobPartId])
  @@index([companyId, jobId])
}

// ── RunWaypoint — non-job stops on a run (depot start, yard, hub, return) ────
model RunWaypoint {
  id             Int       @id @default(autoincrement())
  companyId      Int
  runId          Int
  sequenceNumber Int       @default(0)
  // depot_start | yard_pickup | hub_drop | return_to_base | custom
  waypointType   String    @default("custom")
  locationId     Int?      // optional link to a SavedLocation
  locationText   String?   // free-text fallback when no saved location
  postcode       String?
  lat            Float?
  lng            Float?
  scheduledTime  String?   // HH:MM expected arrival/departure
  notes          String?
  createdAt      DateTime  @default(now())

  run      Run            @relation(fields: [runId], references: [id], onDelete: Cascade)
  location SavedLocation? @relation("RunWaypointLocation", fields: [locationId], references: [id])

  @@index([runId])
  @@index([companyId])
}

// ── LoadTrack — immutable custody ledger ─────────────────────────────────────
// Append-only — NEVER update or delete rows.
model LoadTrack {
  id               Int      @id @default(autoincrement())
  companyId        Int
  jobId            Int
  jobPartId        Int
  runId            Int?
  runAssignmentId  Int?
  eventId          Int
  transactionType  String
  quantity         Decimal
  unit             String   @default("")
  fromCustody      String
  toCustody        String
  driverId         Int?
  trailerId        String   @default("")
  timestamp        DateTime
  serverReceivedAt DateTime @default(now())
  gpsLat           Float?
  gpsLng           Float?
  notes            String?

  company       Company           @relation(fields: [companyId], references: [id])
  job           Job               @relation(fields: [jobId], references: [id])
  jobPart       JobPart           @relation(fields: [jobPartId], references: [id])
  run           Run?              @relation(fields: [runId], references: [id])
  runAssignment RunAssignment?    @relation(fields: [runAssignmentId], references: [id])
  event         JobExecutionEvent @relation(fields: [eventId], references: [id])

  @@index([companyId, jobId])
  @@index([companyId, jobPartId])
  @@index([companyId, runId])
  @@index([companyId, timestamp])
}

model SyncEventLog {
  id            Int      @id @default(autoincrement())
  companyId     Int
  clientEventId String
  eventType     String
  status        String
  failureReason String?
  rawPayload    Json
  receivedAt    DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, clientEventId])
  @@index([receivedAt])
}

model Shift {
  id              Int       @id @default(autoincrement())
  companyId       Int
  driverId        Int
  driverName      String
  shiftDate       DateTime  @default(now())
  oilWaterChecked Boolean   @default(false)
  fuelDrawn       String    @default("")
  adBlueDrawn     String    @default("")
  startTime       String    @default("")
  endTime         String    @default("")
  totalHours      String    @default("")
  breakMins       String    @default("")
  poaMins         String    @default("")
  nightOut        Boolean   @default(false)
  expenses        String    @default("")
  delaysNote      String    @default("")
  defectsNote     String    @default("")
  status          String    @default("draft")
  submittedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company    Company          @relation(fields: [companyId], references: [id])
  driver     User             @relation(fields: [driverId], references: [id])
  segments   ShiftSegment[]
  submitJobs ShiftSubmitJob[]

  @@index([companyId, driverId, shiftDate])
  @@index([companyId, status])
}

model ShiftSegment {
  id                Int       @id @default(autoincrement())
  companyId         Int
  shiftId           Int
  segmentNumber     Int
  vehicleClass      String    @default("tractor")
  truckReg          String
  trailerReg        String?
  odometerStart     Int
  odometerEnd       Int?
  startTime         DateTime  @default(now())
  endTime           DateTime?
  needsTruckCheck   Boolean   @default(true)
  needsTrailerCheck Boolean   @default(true)
  truckChecks       Json
  trailerChecks     Json?
  notes             String    @default("")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company    Company        @relation(fields: [companyId], references: [id])
  shift      Shift          @relation(fields: [shiftId], references: [id])
  deliveries DeliveryTask[]

  @@index([companyId, shiftId])
  @@index([companyId, startTime])
}

model DeliveryTask {
  id          Int      @id @default(autoincrement())
  companyId   Int
  shiftId     Int
  segmentId   Int
  materials   String   @default("")
  collectFrom String   @default("")
  deliverTo   String   @default("")
  ticketNo    String   @default("")
  startTime   String   @default("")
  finishTime  String   @default("")
  hours       String   @default("")
  loadType    String   @default("weight")
  pallets     String   @default("")
  mileage     String   @default("")
  tonnes      String   @default("")
  kgs         String   @default("")
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company      @relation(fields: [companyId], references: [id])
  segment ShiftSegment @relation(fields: [segmentId], references: [id])

  @@index([companyId, segmentId])
  @@index([companyId, shiftId])
}

// ── ShiftSubmitJob — outbox for async PDF/email/working-time processing ───────
// Written in the same transaction as the shift submit; drained by shiftSubmitWorker.
// Fixes B.1: previously setImmediate was used, which loses work on Railway redeploy.
model ShiftSubmitJob {
  id             Int       @id @default(autoincrement())
  shiftId        Int
  companyId      Int
  status         String    @default("pending")   // pending | processing | completed | failed
  attempts       Int       @default(0)
  lastError      String?
  nextAttemptAt  DateTime  @default(now())
  createdAt      DateTime  @default(now())

  shift   Shift   @relation(fields: [shiftId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@index([status, nextAttemptAt])
  @@index([companyId, shiftId])
}

model DriverAvailability {
  id              Int       @id @default(autoincrement())
  companyId       Int
  driverProfileId Int
  weekStartDate   DateTime
  monPref         String    @default("normal")
  tuePref         String    @default("normal")
  wedPref         String    @default("normal")
  thuPref         String    @default("normal")
  friPref         String    @default("normal")
  satPref         String    @default("unavailable")
  sunPref         String    @default("unavailable")
  monNote         String    @default("")
  tueNote         String    @default("")
  wedNote         String    @default("")
  thuNote         String    @default("")
  friNote         String    @default("")
  satNote         String    @default("")
  sunNote         String    @default("")
  status          String    @default("draft")
  submittedAt     DateTime?
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company       Company       @relation(fields: [companyId], references: [id])
  driverProfile DriverProfile @relation(fields: [driverProfileId], references: [id])

  @@unique([driverProfileId, weekStartDate])
  @@index([companyId, status])
  @@index([companyId, weekStartDate])
}

model ShiftPreference {
  id              Int      @id @default(autoincrement())
  companyId       Int
  driverProfileId Int
  shiftDate       DateTime
  preferenceType  String   @default("normal")
  requestedHours  Float?
  finishByTime    String?
  shortDayReason  String   @default("")
  shortDayNote    String   @default("")
  overtimeHours   Float?
  gpsLat          Float?
  gpsLng          Float?
  status          String   @default("pending")
  plannerNote     String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company       Company       @relation(fields: [companyId], references: [id])
  driverProfile DriverProfile @relation(fields: [driverProfileId], references: [id])

  @@index([companyId, driverProfileId, shiftDate])
  @@index([companyId, status])
}

model HolidayRequest {
  id              Int       @id @default(autoincrement())
  companyId       Int
  driverProfileId Int
  startDate       DateTime
  endDate         DateTime
  totalDays       Int
  reason          String    @default("")
  note            String    @default("")
  status          String    @default("pending")
  plannerNote     String    @default("")
  approvedById    Int?
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company       Company       @relation(fields: [companyId], references: [id])
  driverProfile DriverProfile @relation(fields: [driverProfileId], references: [id])

  @@index([companyId, status])
  @@index([companyId, startDate])
}

model DriverWorkingTimeSummary {
  id              Int      @id @default(autoincrement())
  companyId       Int
  driverProfileId Int
  weekStartDate   DateTime
  totalHours      Float    @default(0)
  shiftCount      Int      @default(0)
  reducedRestUsed Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company       Company       @relation(fields: [companyId], references: [id])
  driverProfile DriverProfile @relation(fields: [driverProfileId], references: [id])

  @@unique([driverProfileId, weekStartDate])
  @@index([companyId, driverProfileId, weekStartDate])
}

model FleetUnit {
  id                 Int      @id @default(autoincrement())
  companyId          Int
  company            Company  @relation(fields: [companyId], references: [id])

  registration       String
  vehicleClass       String
  vehicleClassLegacy String   @default("")
  bodyCategory       String   @default("")
  gvwClass           String   @default("")
  bodyType           String   @default("")
  onboardEquipment   Json?
  status             String   @default("available")
  notes              String?

  // Physical dimensions for HGV route restriction checks (ORS)
  heightM            Float?   // overall height in metres (cab + any body)
  widthM             Float?   // overall width in metres
  lengthM            Float?   // overall length in metres (cab only, excl. trailer)
  axleLoadT          Float?   // max axle load in tonnes

  assignedDriverId   Int?
  currentTrailerId   Int?
  yardLocation       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, registration])
}

model FleetTrailer {
  id               Int      @id @default(autoincrement())
  companyId        Int
  company          Company  @relation(fields: [companyId], references: [id])

  registration     String
  trailerType      String
  bodyType         String   @default("")
  trailerLength    String   @default("")
  decks            Int      @default(1)
  compartments     Int?
  onboardEquipment Json?
  status           String   @default("available")
  notes            String?

  // Physical dimensions for HGV route restriction checks (ORS)
  heightM          Float?   // overall height in metres (loaded)
  widthM           Float?   // overall width in metres
  lengthM          Float?   // trailer length in metres (numeric form of trailerLength)
  axleLoadT        Float?   // max axle load in tonnes

  attachedUnitId   Int?
  linkedJobId      Int?
  yardLocation     String?

  // Standing load tracking — updated by Events, never set manually
  loadStatus       String   @default("empty")  // empty | loaded_standing | loaded_with_driver
  standingNote     String?
  standingRunId    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, registration])
  @@index([companyId, linkedJobId])
}

// ── Append-only audit log ─────────────────────────────────────────────────────
// Every sensitive create/update/update/delete/read action is recorded here.
// Rows are NEVER updated or deleted — only appended.
// For job-specific audit use JobAudit; this table covers everything else.
model AuditLog {
  id         Int      @id @default(autoincrement())
  companyId  Int
  actorId    Int?     // User.id who performed the action (null = system)
  entityType String   // "Driver", "FleetUnit", "FleetTrailer", "HolidayRequest", "Shift", "Job", etc.
  entityId   Int      // Primary key of the affected row
  action     String   // "create", "update", "delete", "status_change", "read_sensitive"
  field      String   @default("") // specific field name for updates (empty = whole-record action)
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  requestId  String?
  note       String   @default("") // human-readable summary
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  actor   User?   @relation(fields: [actorId], references: [id])

  @@index([companyId, entityType, entityId])
  @@index([companyId, actorId])
  @@index([companyId, createdAt])
  @@index([createdAt])
}

// ── Customer Request Intake ────────────────────────────────────────────────────
// ClientRequestLink — sharable token link for the PRF (customer request) form.
// On PRF submit the handler validates the token then writes directly to Job (status=pending_review).
model ClientRequestLink {
  id          Int       @id @default(autoincrement())
  companyId   Int
  customerId  Int?
  name        String                        // human label, e.g. "Acme Haulage standing link"
  tokenHash   String    @unique             // SHA-256 of the raw token — used for fast lookups
  rawToken    String?                       // the raw token, stored so it can always be shown again
  isActive    Boolean   @default(true)
  isMain      Boolean   @default(false)     // true for the one auto-created company-wide link
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  usageCount  Int       @default(0)
  createdBy   Int
  templateData Json?         // JSON blob: pre-fill values for the public intake form
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company       Company      @relation(fields: [companyId], references: [id])
  customer      Customer?    @relation(fields: [customerId], references: [id])
  createdByUser User         @relation(fields: [createdBy], references: [id])

  @@index([companyId])
  @@index([tokenHash])
}
