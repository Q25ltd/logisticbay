generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id                           Int      @id @default(autoincrement())
  name                         String
  slug                         String   @unique
  ticker                       String?  @unique
  nextJobSequence              Int      @default(1)
  jobSequenceYear              Int      @default(2026)
  nextRunSequence              Int      @default(1)
  runSequenceYear              Int      @default(2026)
  status                       String   @default("trial")
  reportEmail                  String?
  reportEmailEnabled           Boolean  @default(true)
  maxHolidaysPerDay            Int      @default(2)
  holidayYearResetMonth        Int      @default(1)
  holidayYearResetDay          Int      @default(1)
  holidayWarnDaysBefore        Int      @default(30)
  holidayCarryOverAllowed      Boolean  @default(false)
  holidayCarryOverMaxDays      Int      @default(0)
  baseHolidayAllowanceDays     Int      @default(28)
  holidaySeniorityEnabled      Boolean  @default(true)
  holidaySeniorityYears        Int      @default(5)
  holidaySeniorityExtraDays    Int      @default(1)
  holidaySeniorityMaxExtraDays Int      @default(5)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  memberships      CompanyMembership[]
  driverProfiles   DriverProfile[]
  savedLocations   SavedLocation[]
  customers        Customer[]
  jobTemplates     JobTemplate[]
  plannedJobs      PlannedJob[]
  jobEvents        JobExecutionEvent[]
  shifts           Shift[]
  shiftSegments    ShiftSegment[]
  deliveryTasks    DeliveryTask[]
  availability     DriverAvailability[]
  shiftPreferences ShiftPreference[]
  holidayRequests  HolidayRequest[]
  workingSummaries DriverWorkingTimeSummary[]
  syncEventLogs    SyncEventLog[]
  jobParts         JobPart[]
  loadDetails      LoadDetails[]
  jobAudits        JobAudit[]
  auditLogs        AuditLog[]
  fleetUnits       FleetUnit[]
  fleetTrailers    FleetTrailer[]
  requestLinks     ClientRequestLink[]
  jobRequests      JobRequest[]
  runs             Run[]
  runAssignments   RunAssignment[]
  loadTracks       LoadTrack[]
}

model Customer {
  id           Int      @id @default(autoincrement())
  companyId    Int
  name         String
  contactName  String?
  contactPhone String?
  contactEmail String?
  notes        String?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company      Company             @relation(fields: [companyId], references: [id])
  plannedJobs  PlannedJob[]
  requestLinks ClientRequestLink[]
  jobRequests  JobRequest[]

  @@unique([companyId, name])
  @@index([companyId, status])
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships          CompanyMembership[]
  driverProfile        DriverProfile?
  shifts               Shift[]
  createdJobs          PlannedJob[]        @relation("JobCreatedBy")
  jobEvents            JobExecutionEvent[]
  jobAudits            JobAudit[]
  auditLogs            AuditLog[]
  refreshTokens        RefreshToken[]
  createdRequestLinks  ClientRequestLink[]
  reviewedJobRequests  JobRequest[]        @relation("JobRequestReviewedBy")
}

model RefreshToken {
  id         Int       @id @default(autoincrement())
  userId     Int
  companyId  Int
  tokenHash  String    @unique
  familyId   String
  userAgent  String    @default("")
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt])
  @@index([familyId])
}

model CompanyMembership {
  id        Int      @id @default(autoincrement())
  companyId Int
  userId    Int
  role      String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([companyId, userId])
}

model DriverProfile {
  id                    Int       @id @default(autoincrement())
  companyId             Int
  userId                Int?      @unique
  displayName           String
  employeeNumber        String?
  phoneNumber           String?
  employmentStartDate   DateTime?
  contactEmail          String?
  contactPhone          String?
  driverType            String    @default("permanent")
  licenceClass          String    @default("")
  endorsements          Json?
  canDriveCategories    Json?
  canUseTrailer         Boolean   @default(false)
  trailerTypesAllowed   Json?
  adrAllowed            Boolean   @default(false)
  hiabAllowed           Boolean   @default(false)
  moffettAllowed        Boolean   @default(false)
  manualHandlingAllowed Boolean   @default(false)
  preferredStartTime    String    @default("")
  earliestStartTime     String    @default("")
  latestFinishTime      String    @default("")
  preferredShiftHours   Float?
  normalWorkingDays     Json?
  weekendAvailable      Boolean   @default(false)
  nightWorkAllowed      Boolean   @default(false)
  nightsOutAllowed      Boolean   @default(false)
  overtimeAllowed       Boolean   @default(false)
  baseLocation          String    @default("")
  operatingArea         String    @default("")
  avoidAreas            String    @default("")
  plannerNotes          String    @default("")
  minHoursPerDay        Float     @default(8)
  holidayAllowance      Int       @default(28)
  holidayUsed           Int       @default(0)
  defaultTruckReg       String    @default("")
  defaultTruckClass     String    @default("")
  defaultTrailerReg     String    @default("")
  defaultTrailerClass   String    @default("")
  status                String    @default("active")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  company          Company                    @relation(fields: [companyId], references: [id])
  user             User?                      @relation(fields: [userId], references: [id])
  runs             Run[]
  availability     DriverAvailability[]
  shiftPreferences ShiftPreference[]
  holidayRequests  HolidayRequest[]
  workingSummaries DriverWorkingTimeSummary[]

  @@index([companyId, status])
  @@index([companyId, displayName])
}

model SavedLocation {
  id                   Int      @id @default(autoincrement())
  companyId            Int
  name                 String
  siteName             String   @default("")
  unitName             String   @default("")
  locationTextSnapshot String   @default("")
  street               String   @default("")
  town                 String   @default("")
  postcode             String   @default("")
  lat                  Float?
  lng                  Float?
  gateLat              Float?
  gateLng              Float?
  contactName          String   @default("")
  contactPhone         String   @default("")
  instructions         String   @default("")
  internalNotes        String   @default("")
  accessType           String   @default("unknown")
  accessConfidence     String   @default("low")
  driverReportCount    Int      @default(0)
  issueFlags           Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company          Company       @relation(fields: [companyId], references: [id])
  pickupTemplates  JobTemplate[] @relation("PickupLocation")
  dropoffTemplates JobTemplate[] @relation("DropoffLocation")
  jobParts         JobPart[]

  @@index([companyId, name])
  @@index([companyId, postcode])
}

model JobTemplate {
  id                  Int      @id @default(autoincrement())
  companyId           Int
  name                String
  pickupLocationId    Int?
  dropoffLocationId   Int?
  pickupTextSnapshot  String   @default("")
  dropoffTextSnapshot String   @default("")
  defaultReference    String   @default("")
  defaultNotes        String   @default("")
  defaultMaterialType String   @default("")
  trailerTypesAllowed Json?
  defaultStops        Json?
  defaultLoadDetails  Json?
  defaultJobData      Json?
  qualityScore        Int      @default(0)
  status              String   @default("active")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company         Company        @relation(fields: [companyId], references: [id])
  pickupLocation  SavedLocation? @relation("PickupLocation", fields: [pickupLocationId], references: [id])
  dropoffLocation SavedLocation? @relation("DropoffLocation", fields: [dropoffLocationId], references: [id])
  plannedJobs     PlannedJob[]

  @@index([companyId, status])
}

model PlannedJob {
  id              Int       @id @default(autoincrement())
  companyId       Int
  customerId      Int?
  customerName    String    @default("")
  templateId      Int?
  createdByUserId Int
  plannedDate     DateTime?
  jobReference    String?
  materialType    String    @default("")
  quantityExpected     String    @default("")
  quantityUnit         String    @default("")
  plannerNotes         String    @default("")
  reqBodyCategory      String    @default("")
  reqGvwMin            String    @default("")
  reqBodyType          String    @default("")
  reqEquipment         Json?
  reqLicenceClass      String    @default("")
  trailerTypesAllowed  Json?
  priority             String    @default("normal")
  serviceType          String    @default("")
  customerRef          String    @default("")
  purchaseOrderNumber  String    @default("")
  billingNotes         String    @default("")
  customerInstructions String    @default("")
  custRefRequired      Boolean   @default(false)
  poRequired           Boolean   @default(false)
  minVehicleSize          String    @default("")
  trailerTypesForbidden   Json?
  equipmentRequired       Json?
  driverQualificationsReq Json?
  lengthRestriction       String    @default("")
  vehicleAccessNotes      String    @default("")
  failureAction        String    @default("call_assistance")
  assistancePhone      String    @default("")
  assistanceNote       String    @default("")
  internalNotes        String    @default("")
  validationStatus     String    @default("draft")
  qualityScore         Int       @default(0)
  status               String    @default("draft")
  requirePOD           Boolean   @default(false)

  // Override close fields — set only when planner confirms a quantity mismatch
  overrideClosed            Boolean   @default(false)
  overrideReason            String?
  overrideNotes             String?
  overrideQuantityDelivered Decimal?
  overrideQuantityShortfall Decimal?
  closedAt                  DateTime?
  closedBy                  Int?

  // Vehicle/trailer requirement sources
  vehicleRequirementSource String    @default("not_specified")
  trailerRequirementSource String    @default("not_specified")
  customerVehicleType      String?
  customerTrailerTypes     Json?
  derivedVehicleType       String?
  derivedTrailerTypes      Json?
  finalVehicleType         String?
  finalTrailerTypes        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company             @relation(fields: [companyId], references: [id])
  customer       Customer?           @relation(fields: [customerId], references: [id])
  template       JobTemplate?        @relation(fields: [templateId], references: [id])
  createdBy      User                @relation("JobCreatedBy", fields: [createdByUserId], references: [id])
  events         JobExecutionEvent[]
  stops          JobPart[]
  loadDetails    LoadDetails?
  audits         JobAudit[]
  fromRequest    JobRequest?
  runAssignments RunAssignment[]
  loadTracks     LoadTrack[]

  @@unique([companyId, jobReference])
  @@index([companyId, plannedDate])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([companyId, updatedAt])
  @@index([companyId, validationStatus])
  @@index([companyId, jobReference])
}

// Renamed from JobStop — represents one physical piece of work (collect, deliver, etc.)
model JobPart {
  id        Int @id @default(autoincrement())
  companyId Int
  jobId     Int

  sequenceNumber Int
  type           String

  savedLocationId      Int?
  siteName             String @default("")
  unitName             String @default("")
  street               String @default("")
  town                 String @default("")
  postcode             String @default("")
  locationTextSnapshot String @default("")

  lat     Float?
  lng     Float?
  gateLat Float?
  gateLng Float?

  coordinateVerified Boolean @default(false)

  timeWindowStart           DateTime?
  timeWindowEnd             DateTime?
  bookedTime                DateTime?
  earliestArrivalMinutes    Int?
  unloadingAllowanceMinutes Int?
  standingChargeNote        String    @default("")

  contactName     String @default("")
  contactPhone    String @default("")
  contactEmail    String @default("")
  referenceNumber String @default("")
  bookingRequired Boolean @default(false)
  bookingRef      String  @default("")
  openingHours    String  @default("")
  instructions    String  @default("")
  navigationInstructions String @default("")
  locationType    String  @default("")

  // Quantity tracking
  numPallets         Int?     // legacy field — kept for mobile compatibility
  quantityRequired   Decimal?
  quantityUnit       String   @default("")
  quantityCollected  Decimal  @default(0)
  quantityDelivered  Decimal  @default(0)

  // Proof and access requirements
  proofRequirements  Json?   // ["signature", "photo", "pod_number", "timestamp"]
  accessRequirements Json?   // ["ppe", "high_vis", "induction"]
  handlingMethods    Json?   // ["forklift", "tail_lift", "crane", "manual"]

  // Stop-level load specification — drives trailer compatibility checks
  stopGoodsType        String?
  stopWeight           Decimal?
  temperatureControlled Boolean  @default(false)
  temperatureRange     String?
  hazardous            Boolean  @default(false)
  hazardClass          String?
  oversized            Boolean  @default(false)

  heightRestriction String @default("")
  weightRestriction String @default("")
  internalNotes     String @default("")
  stopNotes         String @default("")
  addressLine2      String @default("")
  countyRegion      String @default("")
  country           String @default("United Kingdom")

  status String @default("pending")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company         Company         @relation(fields: [companyId], references: [id])
  job             PlannedJob      @relation(fields: [jobId], references: [id])
  savedLocation   SavedLocation?  @relation(fields: [savedLocationId], references: [id])
  runAssignments  RunAssignment[]
  loadTracks      LoadTrack[]

  @@map("JobPart")
  @@unique([jobId, sequenceNumber])
  @@index([companyId, jobId])
  @@index([companyId, savedLocationId])
}

model LoadDetails {
  id        Int @id @default(autoincrement())
  companyId Int
  jobId     Int @unique

  quantity Float?
  unit     String @default("")
  weight   Float?
  volume   Float?

  materialType String  @default("")
  hazardClass  String  @default("")
  notes        String  @default("")
  dimensions   String  @default("")
  fragile      Boolean @default(false)
  stackable    Boolean @default(false)
  tempControlled       Boolean @default(false)
  tempRange            String  @default("")
  photosRequired       Boolean @default(false)
  weighbridgeRequired  Boolean @default(false)
  forkliftRequired     Boolean @default(false)
  tailLiftRequired     Boolean @default(false)
  craneRequired        Boolean @default(false)
  loadingMethod        String  @default("")
  unloadingMethod      String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company    @relation(fields: [companyId], references: [id])
  job     PlannedJob @relation(fields: [jobId], references: [id])
}

model JobAudit {
  id        Int  @id @default(autoincrement())
  companyId Int
  jobId     Int
  changedBy Int?

  action   String
  field    String @default("")
  oldValue Json?
  newValue Json?

  createdAt DateTime @default(now())

  company Company    @relation(fields: [companyId], references: [id])
  job     PlannedJob @relation(fields: [jobId], references: [id])
  user    User?      @relation(fields: [changedBy], references: [id])

  @@index([companyId, jobId])
  @@index([createdAt])
}

model JobExecutionEvent {
  id               Int      @id @default(autoincrement())
  jobId            Int
  companyId        Int
  driverId         Int
  eventType        String
  note             String   @default("")
  clientEventId    String
  clientTimestamp  DateTime
  serverReceivedAt DateTime @default(now())
  appVersion       String?
  gpsLat           Float?
  gpsLng           Float?
  needsReview      Boolean  @default(false)
  reviewReason     String?
  createdAt        DateTime @default(now())

  // Phase 1 additions — links to new models (null for historical events)
  runId             Int?
  runAssignmentId   Int?
  jobPartId         Int?
  quantityConfirmed Decimal?
  fromCustody       String?
  toCustody         String?

  job           PlannedJob     @relation(fields: [jobId], references: [id])
  company       Company        @relation(fields: [companyId], references: [id])
  driver        User           @relation(fields: [driverId], references: [id])
  run           Run?           @relation(fields: [runId], references: [id])
  loadTracks    LoadTrack[]

  @@unique([companyId, clientEventId])
  @@index([companyId, createdAt])
  @@index([companyId, runId])
}

// ── Run — the execution container (independent of Job) ───────────────────────
model Run {
  id                          Int       @id @default(autoincrement())
  companyId                   Int
  runReference                String
  status                      String    @default("draft")
  assignedDriverId            Int?
  assignedTruckId             Int?
  assignedTrailerId           Int?
  plannedDate                 DateTime?
  estimatedStartTime          String?
  estimatedEndTime            String?
  actualStartTime             DateTime?
  actualEndTime               DateTime?
  publishedToDriver           Boolean   @default(false)
  plannerNotes                String?
  endInstruction              String?   // drop_trailer_at_base | stay_with_trailer | none
  endInstructionNote          String?
  returnToBase                Boolean   @default(false)
  returnToBaseNote            String?
  returningAt                 DateTime?
  arrivedBaseAt               DateTime?

  // Derived requirements — recalculated when assignments change
  requiredTrailerType         String?
  requiredEquipment           Json?
  maxLoadWeight               Decimal?
  hasHazardous                Boolean   @default(false)
  hasTemperatureLoad          Boolean   @default(false)
  hasOversized                Boolean   @default(false)

  // Compatibility check results — updated at publish time
  trailerCompatible           Boolean   @default(true)
  vehicleCompatible           Boolean   @default(true)
  compatibilityOverridden     Boolean   @default(false)
  compatibilityOverrideReason String?

  createdBy Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company           @relation(fields: [companyId], references: [id])
  driver      DriverProfile?    @relation(fields: [assignedDriverId], references: [id])
  assignments RunAssignment[]
  loadTracks  LoadTrack[]
  events      JobExecutionEvent[]

  @@unique([companyId, runReference])
  @@index([companyId, plannedDate])
  @@index([companyId, status])
  @@index([companyId, assignedDriverId])
}

// ── RunAssignment — bridge between JobPart and Run ───────────────────────────
model RunAssignment {
  id               Int       @id @default(autoincrement())
  companyId        Int
  runId            Int
  jobPartId        Int
  jobId            Int
  sequenceNumber   Int
  quantityAssigned Decimal   @default(0)
  quantityUnit     String    @default("")
  status           String    @default("pending")
  addedAt          DateTime  @default(now())
  addedBy          Int
  removedAt        DateTime?
  removedBy        Int?
  removalReason    String?
  notes            String?

  company    Company    @relation(fields: [companyId], references: [id])
  run        Run        @relation(fields: [runId], references: [id])
  jobPart    JobPart    @relation(fields: [jobPartId], references: [id])
  job        PlannedJob @relation(fields: [jobId], references: [id])
  loadTracks LoadTrack[]

  @@unique([runId, sequenceNumber])
  @@index([companyId, runId])
  @@index([companyId, jobPartId])
  @@index([companyId, jobId])
}

// ── LoadTrack — immutable custody ledger ─────────────────────────────────────
// Append-only — NEVER update or delete rows.
model LoadTrack {
  id               Int      @id @default(autoincrement())
  companyId        Int
  jobId            Int
  jobPartId        Int
  runId            Int?
  runAssignmentId  Int?
  eventId          Int
  transactionType  String
  quantity         Decimal
  unit             String   @default("")
  fromCustody      String
  toCustody        String
  driverId         Int?
  trailerId        String   @default("")
  timestamp        DateTime
  serverReceivedAt DateTime @default(now())
  gpsLat           Float?
  gpsLng           Float?
  notes            String?

  company       Company           @relation(fields: [companyId], references: [id])
  job           PlannedJob        @relation(fields: [jobId], references: [id])
  jobPart       JobPart           @relation(fields: [jobPartId], references: [id])
  run           Run?              @relation(fields: [runId], references: [id])
  runAssignment RunAssignment?    @relation(fields: [runAssignmentId], references: [id])
  event         JobExecutionEvent @relation(fields: [eventId], references: [id])

  @@index([companyId, jobId])
  @@index([companyId, jobPartId])
  @@index([companyId, runId])
  @@index([companyId, timestamp])
}

model SyncEventLog {
  id            Int      @id @default(autoincrement())
  companyId     Int
  clientEventId String
  eventType     String
  status        String
  failureReason String?
  rawPayload    Json
  receivedAt    DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, clientEventId])
  @@index([receivedAt])
}

model Shift {
  id              Int       @id @default(autoincrement())
  companyId       Int
  driverId        Int
  driverName      String
  shiftDate       DateTime  @default(now())
  oilWaterChecked Boolean   @default(false)
  fuelDrawn       String    @default("")
  adBlueDrawn     String    @default("")
  startTime       String    @default("")
  endTime         String    @default("")
  totalHours      String    @default("")
  breakMins       String    @default("")
  poaMins         String    @default("")
  nightOut        Boolean   @default(false)
  expenses        String    @default("")
  delaysNote      String    @default("")
  defectsNote     String    @default("")
  status          String    @default("draft")
  submittedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company  Company        @relation(fields: [companyId], references: [id])
  driver   User           @relation(fields: [driverId], references: [id])
  segments ShiftSegment[]

  @@index([companyId, driverId, shiftDate])
  @@index([companyId, status])
}

model ShiftSegment {
  id                Int       @id @default(autoincrement())
  companyId         Int
  shiftId           Int
  segmentNumber     Int
  vehicleClass      String    @default("tractor")
  truckReg          String
  trailerReg        String?
  odometerStart     Int
  odometerEnd       Int?
  startTime         DateTime  @default(now())
  endTime           DateTime?
  needsTruckCheck   Boolean   @default(true)
  needsTrailerCheck Boolean   @default(true)
  truckChecks       Json
  trailerChecks     Json?
  notes             String    @default("")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company    Company        @relation(fields: [companyId], references: [id])
  shift      Shift          @relation(fields: [shiftId], references: [id])
  deliveries DeliveryTask[]

  @@index([companyId, shiftId])
  @@index([companyId, startTime])
}

model DeliveryTask {
  id          Int      @id @default(autoincrement())
  companyId   Int
  shiftId     Int
  segmentId   Int
  materials   String   @default("")
  collectFrom String   @default("")
  deliverTo   String   @default("")
  ticketNo    String   @default("")
  startTime   String   @default("")
  finishTime  String   @default("")
  hours       String   @default("")
  loadType    String   @default("weight")
  pallets     String   @default("")
  mileage     String   @default("")
  tonnes      String   @default("")
  kgs         String   @default("")
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company      @relation(fields: [companyId], references: [id])
  segment ShiftSegment @relation(fields: [segmentId], references: [id])

  @@index([companyId, segmentId])
  @@index([companyId, shiftId])
}

model DriverAvailability {
  id              Int       @id @default(autoincrement())
  companyId       Int
  driverProfileId Int
  weekStartDate   DateTime
  monPref         String    @default("normal")
  tuePref         String    @default("normal")
  wedPref         String    @default("normal")
  thuPref         String    @default("normal")
  friPref         String    @default("normal")
  satPref         String    @default("unavailable")
  sunPref         String    @default("unavailable")
  monNote         String    @default("")
  tueNote         String    @default("")
  wedNote         String    @default("")
  thuNote         String    @default("")
  friNote         String    @default("")
  satNote         String    @default("")
  sunNote         String    @default("")
  status          String    @default("draft")
  submittedAt     DateTime?
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company       Company       @relation(fields: [companyId], references: [id])
  driverProfile DriverProfile @relation(fields: [driverProfileId], references: [id])

  @@unique([driverProfileId, weekStartDate])
  @@index([companyId, status])
  @@index([companyId, weekStartDate])
}

model ShiftPreference {
  id              Int      @id @default(autoincrement())
  companyId       Int
  driverProfileId Int
  shiftDate       DateTime
  preferenceType  String   @default("normal")
  requestedHours  Float?
  finishByTime    String?
  shortDayReason  String   @default("")
  shortDayNote    String   @default("")
  overtimeHours   Float?
  gpsLat          Float?
  gpsLng          Float?
  status          String   @default("pending")
  plannerNote     String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company       Company       @relation(fields: [companyId], references: [id])
  driverProfile DriverProfile @relation(fields: [driverProfileId], references: [id])

  @@index([companyId, driverProfileId, shiftDate])
  @@index([companyId, status])
}

model HolidayRequest {
  id              Int       @id @default(autoincrement())
  companyId       Int
  driverProfileId Int
  startDate       DateTime
  endDate         DateTime
  totalDays       Int
  reason          String    @default("")
  note            String    @default("")
  status          String    @default("pending")
  plannerNote     String    @default("")
  approvedById    Int?
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company       Company       @relation(fields: [companyId], references: [id])
  driverProfile DriverProfile @relation(fields: [driverProfileId], references: [id])

  @@index([companyId, status])
  @@index([companyId, startDate])
}

model DriverWorkingTimeSummary {
  id              Int      @id @default(autoincrement())
  companyId       Int
  driverProfileId Int
  weekStartDate   DateTime
  totalHours      Float    @default(0)
  shiftCount      Int      @default(0)
  reducedRestUsed Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company       Company       @relation(fields: [companyId], references: [id])
  driverProfile DriverProfile @relation(fields: [driverProfileId], references: [id])

  @@unique([driverProfileId, weekStartDate])
  @@index([companyId, driverProfileId, weekStartDate])
}

model FleetUnit {
  id                 Int      @id @default(autoincrement())
  companyId          Int
  company            Company  @relation(fields: [companyId], references: [id])

  registration       String
  vehicleClass       String
  vehicleClassLegacy String   @default("")
  bodyCategory       String   @default("")
  gvwClass           String   @default("")
  bodyType           String   @default("")
  onboardEquipment   Json?
  status             String   @default("available")
  notes              String?

  assignedDriverId   Int?
  currentTrailerId   Int?
  yardLocation       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, registration])
}

model FleetTrailer {
  id               Int      @id @default(autoincrement())
  companyId        Int
  company          Company  @relation(fields: [companyId], references: [id])

  registration     String
  trailerType      String
  bodyType         String   @default("")
  trailerLength    String   @default("")
  decks            Int      @default(1)
  compartments     Int?
  onboardEquipment Json?
  status           String   @default("available")
  notes            String?

  attachedUnitId   Int?
  linkedJobId      Int?
  yardLocation     String?

  // Standing load tracking — updated by Events, never set manually
  loadStatus       String   @default("empty")  // empty | loaded_standing | loaded_with_driver
  standingNote     String?
  standingRunId    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, registration])
  @@index([companyId, linkedJobId])
}

// ── Append-only audit log ─────────────────────────────────────────────────────
// Every sensitive create/update/delete/read action is recorded here.
// Rows are NEVER updated or deleted — only appended.
// For job-specific audit use JobAudit; this table covers everything else.
model AuditLog {
  id         Int      @id @default(autoincrement())
  companyId  Int
  actorId    Int?     // User.id who performed the action (null = system)
  entityType String   // "Driver", "FleetUnit", "FleetTrailer", "HolidayRequest", "Shift", "Job", etc.
  entityId   Int      // Primary key of the affected row
  action     String   // "create", "update", "delete", "status_change", "read_sensitive"
  field      String   @default("") // specific field name for updates (empty = whole-record action)
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  requestId  String?
  note       String   @default("") // human-readable summary
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  actor   User?   @relation(fields: [actorId], references: [id])

  @@index([companyId, entityType, entityId])
  @@index([companyId, actorId])
  @@index([companyId, createdAt])
  @@index([createdAt])
}

// ── Customer Request Intake ────────────────────────────────────────────────────

model ClientRequestLink {
  id          Int       @id @default(autoincrement())
  companyId   Int
  customerId  Int?
  name        String                        // human label, e.g. "Acme Haulage standing link"
  tokenHash   String    @unique             // SHA-256 of the raw token — never store raw
  isActive    Boolean   @default(true)
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  usageCount  Int       @default(0)
  createdBy   Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company       Company      @relation(fields: [companyId], references: [id])
  customer      Customer?    @relation(fields: [customerId], references: [id])
  createdByUser User         @relation(fields: [createdBy], references: [id])
  requests      JobRequest[]

  @@index([companyId])
  @@index([tokenHash])
}

model JobRequest {
  id            Int  @id @default(autoincrement())
  companyId     Int
  requestLinkId Int?
  customerId    Int? // matched/linked after review

  source String @default("client_request_link") // internal_manual | client_request_link
  status String @default("pending_review")       // pending_review | accepted | rejected | cancelled

  // Denormalized summary fields for list views and filtering (duplicated from requesterData)
  customerName String @default("")
  contactName  String @default("")
  contactPhone String @default("")
  contactEmail String @default("")
  pricingType  String @default("quote_required") // quote_required | agreed_rate_exists | contract_rate_exists | to_be_confirmed

  // JSON blobs — all operational data
  requesterData             Json @default("{}") // customerCompanyName, contactName/Phone/Email, customerReference
  stops                     Json @default("[]") // array of stop objects (see stop shape in routes/jobRequests.ts)
  loadData                  Json @default("{}") // goodsType, description, quantity, unit, weight, conditional fields
  specialRequirementsData   Json @default("{}") // items[], adrClass, unNumber, temperatureRange
  transportRequirementsData Json @default("{}") // plannerDecides, reqBodyCategory, reqBodyType, reqEquipment, trailerTypesAllowed
  billingData               Json @default("{}") // pricingType, declaredGoodsValue, currency, purchaseOrderNumber, billingReference, vatRegistered, vatNumber
  notesData                 Json @default("{}") // driverNoteChips[], driverVisibleNotes, safetyInstructions, customerNotes
  exceptionPolicyData       Json @default("{}") // rejectionAction, alternativeReturnAddress, approvalContactName, etc.
  reviewData                Json? // populated when reviewed: notes, plannerNotes

  // Internal use only (never on public form)
  internalOfficeNotes String?

  // Review outcome
  reviewedAt      DateTime?
  reviewedBy      Int?
  rejectionReason String? // no_capacity | outside_service_area | incomplete_information | pricing_issue | duplicate_request | other
  reviewNotes     String?

  // Linked PlannedJob created on accept (one-to-one)
  convertedJobId Int? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company            @relation(fields: [companyId], references: [id])
  requestLink    ClientRequestLink? @relation(fields: [requestLinkId], references: [id])
  customer       Customer?          @relation(fields: [customerId], references: [id])
  reviewedByUser User?              @relation("JobRequestReviewedBy", fields: [reviewedBy], references: [id])
  convertedJob   PlannedJob?        @relation(fields: [convertedJobId], references: [id])

  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([requestLinkId])
}
